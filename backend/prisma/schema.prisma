generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id           Int          @id @default(autoincrement())
  username     String       @unique
  primeiroNome String
  sobrenome    String
  email        String       @unique
  cpf          String       @unique
  telefone     String
  senha        String
  data_criacao DateTime     @default(now())
  ocorrencia   Ocorrencia[]
}

model Ocorrencia {
  id            Int      @id @default(autoincrement())
  usuarioId     Int
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])
  tipo_animal   String
  origem_animal String?
  situacao      String
  descricao     String
  latitude      Float
  longitude     Float
  foto_url      String?
  data_registro DateTime @default(now())
}

model Instituicao {
  id          Int     @id @default(autoincrement())
  nome        String  @unique
  categoria   String
  descricao   String
  abrangencia String
  uf          String?
  telefone    String?
  email       String?
  endereco    String?
  site        String?
  cnpj        String?
}

model GuiaOrientacao {
  id                Int      @id @default(autoincrement())
  titulo            String
  descricao         String
  situacao          String
  grupo_animal      String
  nivel_risco       String
  o_que_fazer       String[]
  o_que_evitar      String[]
  quando_pedir_ajuda String
  fonte             String
  url_fonte         String?
  ativo             Boolean  @default(true)
  data_criacao      DateTime @default(now())
  data_atualizacao  DateTime @updatedAt

  @@index([situacao, grupo_animal])
  @@index([ativo])
}
