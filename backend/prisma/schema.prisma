generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  Aberto       @map("Aberto")
  Em_andamento @map("Em andamento")
  Finalizado   @map("Finalizado")
}

model Usuario {
  id           Int          @id @default(autoincrement())
  username     String       @unique
  primeiroNome String
  sobrenome    String
  email        String       @unique
  cpf          String       @unique
  telefone     String
  senha        String
  data_criacao DateTime     @default(now())
  ocorrencia   Ocorrencia[]
}

model Ocorrencia {
  id            Int      @id @default(autoincrement())
  usuarioId     Int
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])
  tipo_animal   String
  situacao      String
  descricao     String
  latitude      Float
  longitude     Float
  status        Status   @default(Aberto)
  foto_url      String?
  data_registro DateTime @default(now())
}

model Instituicao {
  id       Int     @id @default(autoincrement())
  nome     String  @unique
  telefone String
  email    String
  endereco String
  site     String?
  cnpj     String?
}
